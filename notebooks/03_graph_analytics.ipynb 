 "cells": [
  {
   "cell_type": "markdown",
   "id": "intro-md",
   "metadata": {},
   "source": [
    "# 03 — Graph Analytics with Neo4j GDS\n",
    "## Movie Collaboration Network Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "imports",
   "metadata": {},
   "outputs": [],
   "source": [
    "from neo4j import GraphDatabase\n",
    "import pandas as pd\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "print('Libraries loaded')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "config",
   "metadata": {},
   "outputs": [],
   "source": [
    "NEO4J_URI  = 'neo4j://127.0.0.1:7687'\n",
    "NEO4J_USER = 'neo4j'\n",
    "NEO4J_PASS = 'Manuvamshi@12'\n",
    "\n",
    "GDS_GRAPH_NAME = 'movies-collab-graph'\n",
    "\n",
    "driver = GraphDatabase.driver(NEO4J_URI, auth=(NEO4J_USER, NEO4J_PASS))\n",
    "print(f'Connected to Neo4j at {NEO4J_URI}')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "preflight-md",
   "metadata": {},
   "source": [
    "## Step 1 — Pre-flight"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "helper",
   "metadata": {},
   "outputs": [],
   "source": [
    "def run_query(query, params=None):\n",
    "    with driver.session() as session:\n",
    "        result = session.run(query, params or {})\n",
    "        return pd.DataFrame([dict(record) for record in result])\n",
    "\n",
    "version_df = run_query(\"CALL dbms.components() YIELD name, versions, edition\")\n",
    "print('Neo4j server info:')\n",
    "print(version_df.to_string(index=False))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "preflight-counts",
   "metadata": {},
   "outputs": [],
   "source": [
    "node_counts = run_query(\"\"\"\n",
    "    MATCH (n)\n",
    "    RETURN labels(n)[0] AS label, COUNT(n) AS count\n",
    "    ORDER BY count DESC\n",
    "\"\"\")\n",
    "print('Node counts per label:')\n",
    "print(node_counts.to_string(index=False))\n",
    "print(f'\\nTotal nodes: {node_counts[\"count\"].sum():,}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "preflight-rels",
   "metadata": {},
   "outputs": [],
   "source": [
    "rel_counts = run_query(\"\"\"\n",
    "    MATCH ()-[r]->()\n",
    "    RETURN type(r) AS type, COUNT(r) AS count\n",
    "    ORDER BY count DESC\n",
    "\"\"\")\n",
    "print('Relationship counts per type:')\n",
    "print(rel_counts.to_string(index=False))\n",
    "\n",
    "total_nodes = node_counts['count'].sum()\n",
    "total_rels  = rel_counts['count'].sum()\n",
    "print(f'\\nTotal relationships: {total_rels:,}')\n",
    "\n",
    "assert total_nodes > 0, 'ERROR: No nodes found! Re-run 02_graph_load.ipynb first.'\n",
    "assert total_rels  > 0, 'ERROR: No relationships found! Re-run 02_graph_load.ipynb first.'\n",
    "print('\\nPre-flight PASSED')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "project-md",
   "metadata": {},
   "source": [
    "## Step 2 — Project Graph into GDS"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "drop-existing",
   "metadata": {},
   "outputs": [],
   "source": [
    "with driver.session() as session:\n",
    "    exists_result = session.run(\n",
    "        \"CALL gds.graph.exists($name) YIELD exists\",\n",
    "        name=GDS_GRAPH_NAME\n",
    "    )\n",
    "    exists = exists_result.single()['exists']\n",
    "\n",
    "if exists:\n",
    "    with driver.session() as session:\n",
    "        session.run(\"CALL gds.graph.drop($name)\", name=GDS_GRAPH_NAME)\n",
    "    print(f'Dropped existing projection: {GDS_GRAPH_NAME}')\n",
    "else:\n",
    "    print('No existing projection. Creating fresh.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "project",
   "metadata": {},
   "outputs": [],
   "source": [
    "with driver.session() as session:\n",
    "    result = session.run(\"\"\"\n",
    "        CALL gds.graph.project(\n",
    "            $name,\n",
    "            ['Movie', 'Director', 'Actor'],\n",
    "            {\n",
    "                DIRECTED:          {orientation: 'UNDIRECTED'},\n",
    "                ACTED_IN:          {orientation: 'UNDIRECTED'},\n",
    "                COLLABORATED_WITH: {orientation: 'UNDIRECTED'}\n",
    "            }\n",
    "        )\n",
    "        YIELD graphName, nodeCount, relationshipCount\n",
    "    \"\"\", name=GDS_GRAPH_NAME)\n",
    "    row = result.single()\n",
    "\n",
    "print(f'GDS projection created: \"{row[\"graphName\"]}\"')\n",
    "print(f'  Nodes projected:         {row[\"nodeCount\"]:,}')\n",
    "print(f'  Relationships projected: {row[\"relationshipCount\"]:,}')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "pagerank-md",
   "metadata": {},
   "source": [
    "## Step 3 — PageRank"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "pagerank-run",
   "metadata": {},
   "outputs": [],
   "source": [
    "with driver.session() as session:\n",
    "    result = session.run(\"\"\"\n",
    "        CALL gds.pageRank.write(\n",
    "            $name,\n",
    "            {\n",
    "                writeProperty: 'pagerank',\n",
    "                maxIterations: 20,\n",
    "                dampingFactor: 0.85\n",
    "            }\n",
    "        )\n",
    "        YIELD nodePropertiesWritten, ranIterations\n",
    "    \"\"\", name=GDS_GRAPH_NAME)\n",
    "    row = result.single()\n",
    "\n",
    "print(f'PageRank complete.')\n",
    "print(f'  Properties written: {row[\"nodePropertiesWritten\"]:,}')\n",
    "print(f'  Iterations run:     {row[\"ranIterations\"]}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "pagerank-top10-all",
   "metadata": {},
   "outputs": [],
   "source": [
    "top10_all = run_query(\"\"\"\n",
    "    MATCH (n)\n",
    "    WHERE n.pagerank IS NOT NULL\n",
    "    RETURN labels(n)[0]              AS label,\n",
    "           COALESCE(n.name, n.title) AS name,\n",
    "           ROUND(n.pagerank, 4)       AS pagerank\n",
    "    ORDER BY pagerank DESC\n",
    "    LIMIT 10\n",
    "\"\"\")\n",
    "print('Top 10 nodes by PageRank (all labels):')\n",
    "print(top10_all.to_string(index=False))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "pagerank-top10-directors",
   "metadata": {},
   "outputs": [],
   "source": [
    "top10_directors = run_query(\"\"\"\n",
    "    MATCH (d:Director)\n",
    "    WHERE d.pagerank IS NOT NULL\n",
    "    RETURN d.name               AS director,\n",
    "           ROUND(d.pagerank, 4)  AS pagerank\n",
    "    ORDER BY pagerank DESC\n",
    "    LIMIT 10\n",
    "\"\"\")\n",
    "print('Top 10 Directors by PageRank:')\n",
    "print(top10_directors.to_string(index=False))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "pagerank-top10-actors",
   "metadata": {},
   "outputs": [],
   "source": [
    "top10_actors = run_query(\"\"\"\n",
    "    MATCH (a:Actor)\n",
    "    WHERE a.pagerank IS NOT NULL\n",
    "    RETURN a.name               AS actor,\n",
    "           ROUND(a.pagerank, 4)  AS pagerank\n",
    "    ORDER BY pagerank DESC\n",
    "    LIMIT 10\n",
    "\"\"\")\n",
    "print('Top 10 Actors by PageRank:')\n",
    "print(top10_actors.to_string(index=False))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "pagerank-top10-movies",
   "metadata": {},
   "outputs": [],
   "source": [
    "top10_movies = run_query(\"\"\"\n",
    "    MATCH (m:Movie)\n",
    "    WHERE m.pagerank IS NOT NULL\n",
    "    RETURN m.title                  AS movie,\n",
    "           m.release_year           AS year,\n",
    "           ROUND(m.revenue/1e6, 1)  AS revenue_M,\n",
    "           ROUND(m.pagerank, 4)      AS pagerank\n",
    "    ORDER BY pagerank DESC\n",
    "    LIMIT 10\n",
    "\"\"\")\n",
    "print('Top 10 Movies by PageRank:')\n",
    "print(top10_movies.to_string(index=False))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "pagerank-interpret-md",
   "metadata": {},
   "source": [
    "### PageRank — Business Interpretation\n",
    "\n",
    "The top-ranked Directors in our collaboration network are those who have worked with many high-profile actors and whose films are densely connected to other successful productions. A director with a high PageRank score is not just prolific — they sit at the structural heart of the collaboration network, meaning their projects consistently attract and connect the most influential talent in the industry. For a film production executive, a high-PageRank director is the safest greenlight signal: their attachment alone pulls in connected, commercially proven actors.\n",
    "\n",
    "The top-ranked Movies are the structural hubs of the network — films that connected multiple prominent directors and actors who had not previously worked together, or that anchored franchise collaborations. Recommending a new film collaboration should prioritize pairings that resemble the genre, budget band, and director-actor profile of these hub movies, as they represent the highest cross-cluster connectivity and commercial reach in our dataset."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "louvain-md",
   "metadata": {},
   "source": [
    "## Step 4 — Louvain Community Detection"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "louvain-run",
   "metadata": {},
   "outputs": [],
   "source": [
    "with driver.session() as session:\n",
    "    result = session.run(\"\"\"\n",
    "        CALL gds.louvain.write(\n",
    "            $name,\n",
    "            {\n",
    "                writeProperty: 'community',\n",
    "                maxLevels:     10,\n",
    "                tolerance:     0.0001\n",
    "            }\n",
    "        )\n",
    "        YIELD nodePropertiesWritten, communityCount, modularity\n",
    "    \"\"\", name=GDS_GRAPH_NAME)\n",
    "    row = result.single()\n",
    "\n",
    "print(f'Louvain complete.')\n",
    "print(f'  Properties written: {row[\"nodePropertiesWritten\"]:,}')\n",
    "print(f'  Communities found:  {row[\"communityCount\"]}')\n",
    "print(f'  Modularity score:   {row[\"modularity\"]:.4f}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "louvain-sizes",
   "metadata": {},
   "outputs": [],
   "source": [
    "community_sizes = run_query(\"\"\"\n",
    "    MATCH (n)\n",
    "    WHERE n.community IS NOT NULL\n",
    "    RETURN n.community AS community_id,\n",
    "           COUNT(n)    AS size\n",
    "    ORDER BY size DESC\n",
    "    LIMIT 10\n",
    "\"\"\")\n",
    "print('Top 10 communities by size:')\n",
    "print(community_sizes.to_string(index=False))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "louvain-top3-detail",
   "metadata": {},
   "outputs": [],
   "source": [
    "top3_communities = community_sizes['community_id'].head(3).tolist()\n",
    "\n",
    "for comm_id in top3_communities:\n",
    "    print(f'\\n=== Community {comm_id} ===')\n",
    "\n",
    "    directors = run_query(\"\"\"\n",
    "        MATCH (d:Director {community: $cid})\n",
    "        RETURN d.name AS director\n",
    "        ORDER BY d.pagerank DESC\n",
    "        LIMIT 5\n",
    "    \"\"\", params={'cid': int(comm_id)})\n",
    "    print(f'  Top Directors: {directors[\"director\"].tolist()}')\n",
    "\n",
    "    actors = run_query(\"\"\"\n",
    "        MATCH (a:Actor {community: $cid})\n",
    "        RETURN a.name AS actor\n",
    "        ORDER BY a.pagerank DESC\n",
    "        LIMIT 5\n",
    "    \"\"\", params={'cid': int(comm_id)})\n",
    "    print(f'  Top Actors:    {actors[\"actor\"].tolist()}')\n",
    "\n",
    "    movies = run_query(\"\"\"\n",
    "        MATCH (m:Movie {community: $cid})\n",
    "        RETURN m.title AS movie, m.release_year AS year,\n",
    "               ROUND(m.revenue/1e6, 0) AS revenue_M\n",
    "        ORDER BY m.revenue DESC\n",
    "        LIMIT 5\n",
    "    \"\"\", params={'cid': int(comm_id)})\n",
    "    print(f'  Top Movies:    {movies[[\"movie\", \"year\", \"revenue_M\"]].values.tolist()}')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "louvain-interpret-md",
   "metadata": {},
   "source": [
    "### Louvain Community Detection — Business Interpretation\n",
    "\n",
    "The Louvain algorithm partitioned the movie collaboration network into distinct communities based purely on structural connectivity — which directors, actors, and films were densely interconnected through shared projects. The three largest communities each represent a coherent creative cluster. The largest community contains the high-budget franchise collaborations (superhero, action-adventure), anchored by directors and actors who repeatedly worked within the same studio ecosystem. The second community clusters around mid-budget drama and thriller productions with a different but equally stable set of recurring creative partnerships. The third community represents a more international or genre-specific segment, with collaborations that span fewer total films but within a tight creative circle.\n",
    "\n",
    "For a film studio executive, the community label of a director-actor pair is a useful segmentation signal: it tells you which creative ecosystem a proposed collaboration belongs to, what the comparable revenue base looks like within that cluster, and whether a new pairing connects two nodes from within the same community (lower risk, proven compatibility) or bridges two separate communities (higher novelty, potentially higher ceiling but less predictable)."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "export-md",
   "metadata": {},
   "source": [
    "## Step 5 — Export GDS Features for ML Enrichment"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "export-features",
   "metadata": {},
   "outputs": [],
   "source": [
    "gds_features = run_query(\"\"\"\n",
    "    MATCH (m:Movie)\n",
    "    WHERE m.pagerank IS NOT NULL\n",
    "    RETURN m.title     AS node_id,\n",
    "           m.pagerank  AS pagerank,\n",
    "           m.community AS community\n",
    "\"\"\")\n",
    "\n",
    "print(f'Exported GDS features for {len(gds_features):,} movie nodes')\n",
    "print(f'Columns: {list(gds_features.columns)}')\n",
    "print(f'\\nPageRank stats:')\n",
    "print(gds_features['pagerank'].describe().round(4))\n",
    "print(f'\\nCommunity distribution (top 5):')\n",
    "print(gds_features['community'].value_counts().head())\n",
    "gds_features.head(10)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "export-save",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "os.makedirs('../data', exist_ok=True)\n",
    "\n",
    "out_path = '../data/gds_features.parquet'\n",
    "gds_features.to_parquet(out_path, index=False)\n",
    "print(f'Saved: {out_path}')\n",
    "print(f'Shape: {gds_features.shape}')\n",
    "print('Ready for pd.merge in 04_ml.ipynb on key: node_id')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "drop-md",
   "metadata": {},
   "source": [
    "## Step 6 — Drop the GDS Projection"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "drop-projection",
   "metadata": {},
   "outputs": [],
   "source": [
    "with driver.session() as session:\n",
    "    session.run(\"CALL gds.graph.drop($name)\", name=GDS_GRAPH_NAME)\n",
    "\n",
    "print(f'GDS projection \"{GDS_GRAPH_NAME}\" dropped.')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "summary-md",
   "metadata": {},
   "source": [
    "## Step 7 — Summary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "summary",
   "metadata": {},
   "outputs": [],
   "source": [
    "pagerank_stats  = run_query(\"\"\"\n",
    "    MATCH (n) WHERE n.pagerank IS NOT NULL\n",
    "    RETURN COUNT(n)                  AS nodes_scored,\n",
    "           ROUND(MIN(n.pagerank), 4) AS min_pr,\n",
    "           ROUND(MAX(n.pagerank), 4) AS max_pr,\n",
    "           ROUND(AVG(n.pagerank), 4) AS avg_pr\n",
    "\"\"\")\n",
    "community_stats = run_query(\"\"\"\n",
    "    MATCH (n) WHERE n.community IS NOT NULL\n",
    "    RETURN COUNT(n)                    AS nodes_labelled,\n",
    "           COUNT(DISTINCT n.community) AS num_communities\n",
    "\"\"\")\n",
    "\n",
    "print('=' * 50)\n",
    "print('GRAPH ANALYTICS SUMMARY')\n",
    "print('=' * 50)\n",
    "print(f\"Nodes scored (PageRank):  {pagerank_stats['nodes_scored'][0]:,}\")\n",
    "print(f\"  Min: {pagerank_stats['min_pr'][0]}  Max: {pagerank_stats['max_pr'][0]}  Avg: {pagerank_stats['avg_pr'][0]}\")\n",
    "print(f\"Nodes labelled (Louvain): {community_stats['nodes_labelled'][0]:,}\")\n",
    "print(f\"Communities found:        {community_stats['num_communities'][0]}\")\n",
    "print(f\"GDS features exported:    {len(gds_features):,} rows -> ../data/gds_features.parquet\")\n",
    "print('=' * 50)\n",
    "print('Next: open 04_ml.ipynb and run the S6 enrichment section.')"
   ]
  },
